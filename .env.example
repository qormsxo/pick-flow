NODE_ENV=development
PORT=3000

# PostgreSQL (docker-compose 기본값)
DATABASE_URL=postgres://pickflow:pickflow@localhost:5432/pickflow

# Redis Stack. 일반 redis 이미지는 Vector Search(FT.SEARCH)가 없다.
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-to-a-long-random-string-32b
JWT_EXPIRES_SEC=86400

# fake = API 비용 0원. gemini 로 바꾸면 GEMINI_API_KEY 가 필수다.
# k6 는 npm run start:load 로 띄운다. LOAD_TEST=true 가 되고 AI 는 fake 로 고정된다.
AI_PROVIDER=fake
# 임베딩은 짧게 두고, 답변 생성만 짧은 Gemini 응답(약 1.2초)에 맞춘다.
AI_FAKE_LATENCY_MS=20
AI_FAKE_CHAT_LATENCY_MS=1200
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# fake 와 Gemini(outputDimensionality 축소)가 같은 384차원을 쓴다.
# 공급자나 차원을 바꾸면 Redis 인덱스를 지우고 상품 임베딩을 다시 만들어야 한다.
EMBEDDING_DIM=384

# 코사인 유사도. 1에 가까울수록 더 비슷한 질문만 캐시 히트로 인정한다.
SEMANTIC_CACHE_THRESHOLD=0.86
SEMANTIC_CACHE_COALESCE_THRESHOLD=0.78
SEMANTIC_CACHE_TTL_SEC=86400
SEMANTIC_CACHE_TOP_K=1

REQUEST_TIMEOUT_MS=10000
